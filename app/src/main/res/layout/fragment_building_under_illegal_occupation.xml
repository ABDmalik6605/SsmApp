<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/parentView"
    android:background="@color/whitesmoke"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="@dimen/textsize_medium"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/tv_buic_title"
        android:background="@color/boundary_wall_text_bg_color"
        android:padding="15dp"
        android:layout_width="match_parent"
        android:layout_height="@dimen/layout_header"
        android:text="building under illegal occupation"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true"/>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/tv_buic_title">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/x10">
                <TextView
                    android:textSize="@dimen/textsize_medium"
                    android:textStyle="bold"
                    android:textColor="@color/boundary_wall_text_bg_color"
                    android:id="@+id/tv_does_the_school_have_a_building"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="does the school have a building"/>
                <RelativeLayout
                    android:background="@drawable/bw_yes_no_bg"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/x5"
                    android:layout_below="@+id/tv_does_the_school_have_a_building">
                    <RadioGroup
                        android:id="@+id/rg_school_building"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/x2"
                        android:layout_centerVertical="true">
                        <RadioButton
                            android:textSize="@dimen/textsize_medium"
                            android:textColor="@color/boundary_wall_text_bg_color"
                            android:id="@+id/rb_does_the_school_have_a_building_yes"
                            android:padding="@dimen/x5"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_margin="@dimen/x2"
                            android:checked="true"
                            android:button="@drawable/radiobuttonstate"
                            android:text="@string/yes"/>
                        <RadioButton
                            android:textSize="@dimen/textsize_medium"
                            android:textColor="@color/boundary_wall_text_bg_color"
                            android:id="@+id/rb_does_the_school_have_a_building_no"
                            android:padding="@dimen/x5"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_margin="@dimen/x2"
                            android:checked="false"
                            android:button="@drawable/radiobuttonstate"
                            android:text="@string/no"/>
                    </RadioGroup>
                </RelativeLayout>
            </RelativeLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/rl_illegal_building"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/x10">
                    <TextView
                        android:textSize="@dimen/textsize_medium"
                        android:textStyle="bold"
                        android:textColor="@color/boundary_wall_text_bg_color"
                        android:id="@+id/tv_buidling_under_illegal_occupation"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="is the building under any illegal occupation"/>
                    <RelativeLayout
                        android:id="@+id/rv_radio_group"
                        android:background="@drawable/bw_yes_no_bg"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/x5"
                        android:layout_below="@+id/tv_buidling_under_illegal_occupation">
                        <RadioGroup
                            android:id="@+id/rg_builiding_illegal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_margin="@dimen/x2"
                            android:layout_centerVertical="true">
                            <RadioButton
                                android:textSize="@dimen/textsize_medium"
                                android:textColor="@color/boundary_wall_text_bg_color"
                                android:id="@+id/rb_yes"
                                android:padding="@dimen/x5"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_margin="@dimen/x2"
                                android:checked="false"
                                android:button="@drawable/radiobuttonstate"
                                android:text="@string/yes"/>
                            <RadioButton
                                android:textSize="@dimen/textsize_medium"
                                android:textColor="@color/boundary_wall_text_bg_color"
                                android:id="@+id/rb_no"
                                android:padding="@dimen/x5"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_margin="@dimen/x2"
                                android:checked="true"
                                android:button="@drawable/radiobuttonstate"
                                android:text="@string/no"/>
                        </RadioGroup>
                    </RelativeLayout>
                </RelativeLayout>
                <RelativeLayout
                    android:id="@+id/rl_ramarks"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/x10">
                    <TextView
                        android:textSize="@dimen/textsize_medium"
                        android:textStyle="bold"
                        android:textColor="@color/boundary_wall_text_bg_color"
                        android:id="@+id/tv_remarks"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="remarks"/>
                    <LinearLayout
                        android:gravity="center"
                        android:background="@drawable/bw_dropdown_bg"
                        android:padding="@dimen/x5"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:layout_below="@+id/tv_remarks">
                        <com.jaredrummler.materialspinner.MaterialSpinner
                            android:id="@+id/sp_remarks"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            app:ms_background_color="@color/white"
                            app:ms_dropdown_height="wrap_content"
                            app:ms_dropdown_max_height="@dimen/x350"
                            app:ms_text_color="@color/boundary_wall_text_bg_color"/>
                    </LinearLayout>
                </RelativeLayout>
                <RelativeLayout
                    android:id="@+id/rl_comments"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/x10">
                    <TextView
                        android:textSize="@dimen/textsize_medium"
                        android:textStyle="bold"
                        android:textColor="@color/boundary_wall_text_bg_color"
                        android:id="@+id/tv_comments"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="comments"/>
                    <LinearLayout
                        android:background="@drawable/bw_comments_bg"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/x5"
                        android:layout_below="@+id/tv_comments">
                        <EditText
                            android:scrollbarStyle="insideInset"
                            android:textSize="@dimen/textsize_medium"
                            android:id="@+id/editText_comments"
                            android:background="@null"
                            android:paddingLeft="10dp"
                            android:paddingTop="5dp"
                            android:paddingRight="10dp"
                            android:paddingBottom="5dp"
                            android:scrollbars="vertical"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="write your comments..."
                            android:maxLines="5"
                            android:maxLength="100"
                            android:overScrollMode="always"
                            android:nestedScrollingEnabled="true"/>
                    </LinearLayout>
                </RelativeLayout>
                <ImageView
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/previewImage"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/image_preview_height"
                    android:layout_margin="@dimen/x10"/>
                <ImageView
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/uploadImage"
                    android:background="@drawable/bw_upload_image_button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/x10"/>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/x10"
                android:weightSum="2">
                <Button
                    android:textColor="@color/white"
                    android:id="@+id/save_button"
                    android:background="@color/colorAccent"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/x2"
                    android:text="   Save   "
                    android:layout_weight="1"/>
                <Button
                    android:textColor="@color/white"
                    android:id="@+id/cancel_button"
                    android:background="@color/colorAccent"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/x2"
                    android:text="   Cancel   "
                    android:layout_weight="1"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</RelativeLayout>
