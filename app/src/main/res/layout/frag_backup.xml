<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="@dimen/textsize_medium"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/tv_census_widget"
        android:background="@color/boundary_wall_text_bg_color"
        android:padding="15dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Backup Data"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true"/>
    <TextView
        android:textAppearance="?android:attr/textAppearanceMedium"
        android:textColor="@color/black"
        android:gravity="center"
        android:id="@+id/tv_cal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/x40"
        android:text="Backup will be created as on Today&apos;s date and time"
        android:layout_marginStart="@dimen/x20"
        android:layout_marginEnd="@dimen/x20"/>
    <Button
        android:textColor="@color/white"
        android:layout_gravity="center_horizontal"
        android:id="@+id/btn_back_up"
        android:background="@color/colorAccent"
        android:padding="@dimen/x5"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/x25"
        android:text="BACKUP DATA"
        android:paddingStart="@dimen/x10"
        android:paddingEnd="@dimen/x10"/>
    <Button
        android:textColor="@color/white"
        android:layout_gravity="center_horizontal"
        android:id="@+id/btn_Manual_sync"
        android:background="@color/colorAccent"
        android:padding="@dimen/x5"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/x25"
        android:text="@string/Manual_sync"
        android:paddingStart="@dimen/x10"
        android:paddingEnd="@dimen/x10"/>
</LinearLayout>
