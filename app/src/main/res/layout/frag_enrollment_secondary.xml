                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/x10">
                    <TextView
                        android:textSize="@dimen/textsize_medium"
                        android:textStyle="bold"
                        android:textColor="@color/boundary_wall_text_bg_color"
                        android:id="@+id/tv_total_no_of_classrooms"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Total student’s enrollment in school"/>
                    <LinearLayout
                        android:background="@drawable/bw_dropdown_bg"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/x5"
                        android:layout_below="@+id/tv_total_no_of_classrooms">
                        <EditText
                            android:enabled="false"
                            android:textSize="@dimen/textsize_medium"
                            android:id="@+id/et_total_enrollments"
                            android:background="@null"
                            android:paddingLeft="10dp"
                            android:paddingTop="5dp"
                            android:paddingRight="10dp"
                            android:paddingBottom="5dp"
                            android:focusable="false"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:hint=""
                            android:maxLines="1"
                            android:maxLength="10"
                            android:inputType="number"/>
                    </LinearLayout>
                </RelativeLayout>
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
