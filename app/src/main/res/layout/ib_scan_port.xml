<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/infoLayout"
    android:background="#ffffffff"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="horizontal"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10sp"
        android:layout_marginBottom="20sp">
        <ImageView
            android:id="@+id/logo"
            android:layout_width="150sp"
            android:layout_height="wrap_content"
            android:src="@mipmap/ic_launcher"
            android:contentDescription="logo img"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#ff0060a0"
                android:gravity="start"
                android:id="@+id/title"
                android:paddingLeft="25sp"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/app_name"
                android:textIsSelectable="false"
                android:paddingStart="25sp"/>
            <TextView
                android:textSize="12sp"
                android:textColor="#ff0060a0"
                android:gravity="start"
                android:id="@+id/version"
                android:paddingLeft="25sp"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text=""
                android:textIsSelectable="false"
                android:paddingStart="25sp"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:background="#ffffffff"
        android:paddingTop="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <Button
            android:textSize="13sp"
            android:layout_gravity="center"
            android:id="@+id/refresh_btn"
            android:padding="5sp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/refresh_btn"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            style="?android:attr/buttonBarButtonStyle"/>
        <Button
            android:textSize="13sp"
            android:layout_gravity="center"
            android:id="@+id/open_scanner_btn"
            android:padding="5sp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Start Scanning"
            android:layout_weight="1"
            android:layout_marginStart="5dp"
            style="?android:attr/buttonBarButtonStyle"/>
        <Button
            android:textSize="13sp"
            android:layout_gravity="center"
            android:id="@+id/close_scanner_btn"
            android:padding="10sp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Stop Scanning"
            android:layout_weight="1"
            android:layout_marginStart="5dp"
            style="?android:attr/buttonBarButtonStyle"/>
        <Button
            android:textSize="13sp"
            android:layout_gravity="center"
            android:id="@+id/start_capture_btn"
            android:padding="10sp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Start Scanning"
            android:layout_weight="1"
            android:layout_marginStart="5dp"
            style="?android:attr/buttonBarButtonStyle"/>
        <Button
            android:textSize="13sp"
            android:layout_gravity="center"
            android:id="@+id/stop_capture_btn"
            android:padding="10sp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Stop Scanning"
            android:layout_weight="1"
            android:layout_marginStart="5dp"
            style="?android:attr/buttonBarButtonStyle"/>
        <Button
            android:textSize="13sp"
            android:layout_gravity="center"
            android:id="@+id/empty_btn"
            android:padding="10sp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text=""
            android:layout_weight="1"
            android:layout_marginStart="5dp"
            style="?android:attr/buttonBarButtonStyle"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="40dp">
        <Button
            android:textSize="16sp"
            android:textColor="@color/white"
            android:gravity="fill_vertical"
            android:id="@+id/view_database_btn"
            android:background="@color/colorAccent"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_margin="5dp"
            android:text="@string/view_database_btn"
            style="?android:attr/buttonBarButtonStyle"/>
        <Spinner
            android:textSize="16sp"
            android:textColor="#ff000000"
            android:id="@+id/capture_type"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="40dp">
        <Spinner
            android:textSize="16sp"
            android:textColor="#ff000000"
            android:id="@+id/action_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>
    </LinearLayout>
    <TextView
        android:textSize="14sp"
        android:textColor="#ff000000"
        android:gravity="center"
        android:id="@+id/action_state"
        android:background="#ffbbbbdd"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:text="@string/action_state_default"/>
    <LinearLayout
        android:orientation="horizontal"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="true">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <TextView
                android:textSize="14sp"
                android:textColor="#ff000000"
                android:gravity="center"
                android:id="@+id/device_count_title"
                android:background="#ffccccee"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/device_count_name"/>
            <TextView
                android:textSize="14sp"
                android:textColor="#ff000000"
                android:gravity="center"
                android:id="@+id/device_count"
                android:background="#ffeeeeff"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/device_count_default"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <TextView
                android:textSize="14sp"
                android:textColor="#ff000000"
                android:gravity="center"
                android:id="@+id/status_title"
                android:background="#ffccccee"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/status_name"/>
            <TextView
                android:textSize="14sp"
                android:textColor="#ff000000"
                android:gravity="center"
                android:id="@+id/status"
                android:background="#ffeeeeff"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/status_default"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <TextView
                android:textSize="14sp"
                android:textColor="#ff000000"
                android:gravity="center"
                android:id="@+id/frame_time_title"
                android:background="#ffccccee"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/frame_time_name"/>
            <TextView
                android:textSize="14sp"
                android:textColor="#ff000000"
                android:gravity="center"
                android:id="@+id/frame_time"
                android:background="#ffeeeeff"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/frame_time_default"/>
        </LinearLayout>
    </LinearLayout>
    <TextView
        android:textSize="16sp"
        android:textColor="#ff000000"
        android:gravity="center"
        android:id="@+id/description"
        android:background="#ffff0000"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10sp"
        android:text=""
        android:layout_marginStart="20sp"
        android:layout_marginEnd="20sp"/>
    <LinearLayout
        android:orientation="horizontal"
        android:background="#ffcccccc"
        android:layout_width="match_parent"
        android:layout_height="12sp"
        android:layout_marginStart="20sp"
        android:layout_marginEnd="20sp">
        <TextView
            android:textSize="12sp"
            android:id="@+id/scan_states_color1"
            android:background="#ff00ff00"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text=""
            android:layout_weight="1"
            android:layout_marginStart="10sp"
            android:layout_marginEnd="10sp"/>
        <TextView
            android:textSize="12sp"
            android:id="@+id/scan_states_color2"
            android:background="#ff0000ff"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginRight="10sp"
            android:text=""
            android:layout_weight="1"
            android:layout_marginEnd="10sp"/>
        <TextView
            android:textSize="12sp"
            android:id="@+id/scan_states_color3"
            android:background="#ff00ffff"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginRight="10sp"
            android:text=""
            android:layout_weight="1"
            android:layout_marginEnd="10sp"/>
        <TextView
            android:textSize="12sp"
            android:id="@+id/scan_states_color4"
            android:background="#ffff00ff"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginRight="10sp"
            android:text=""
            android:layout_weight="1"
            android:layout_marginEnd="10sp"/>
    </LinearLayout>
    <ImageView
        android:id="@+id/preview_image"
        android:background="#ffeeeeee"
        android:paddingBottom="14sp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="10sp"
        android:contentDescription="@string/preview_image"
        android:paddingStart="14sp"
        android:paddingEnd="14sp"
        android:layout_marginStart="20sp"
        android:layout_marginEnd="20sp"/>
</LinearLayout>
