<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/ll_cnicSearch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/x20"
                android:layout_marginBottom="@dimen/x20">
                <TextView
                    android:textAppearance="?android:attr/textAppearanceMedium"
                    android:textColor="@color/black"
                    android:id="@+id/tv_nic"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Employee CNIC"
                    android:maxLines="1"
                    android:layout_marginStart="@dimen/x15"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:layout_gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/x5">
                    <EditText
                        android:id="@+id/et_cnic"
                        android:background="@drawable/input_field"
                        android:paddingTop="@dimen/activity_vertical_margin"
                        android:paddingBottom="@dimen/activity_vertical_margin"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:hint="CNIC (e.g: xxxxxxxxxxxxx)"
                        android:maxLines="1"
                        android:maxLength="13"
                        android:layout_weight="5"
                        android:inputType="textNoSuggestions|number"
                        android:paddingStart="@dimen/activity_horizontal_margin"
                        android:paddingEnd="@dimen/x8"
                        android:layout_marginStart="@dimen/x15"/>
                    <Button
                        android:enabled="false"
                        android:textColor="@color/white"
                        android:id="@+id/btn_search"
                        android:background="@drawable/rounded_button_new_disabled"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginTop="@dimen/x1"
                        android:layout_marginBottom="@dimen/x3"
                        android:text=" Search "
                        android:layout_weight="2"
                        android:layout_marginEnd="@dimen/x15"
                        android:elevation="4dp"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/ll_thumb_register"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="@dimen/textsize_medium"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:id="@+id/tv_attendance"
                    android:background="@color/boundary_wall_text_bg_color"
                    android:padding="15dp"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Register Thumb"/>
                <TextView
                    android:textSize="@dimen/textsize_medium"
                    android:textStyle="bold"
                    android:textColor="@color/boundary_wall_text_bg_color"
                    android:id="@+id/tv_biometric"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/x10"
                    android:layout_marginBottom="@dimen/x10"
                    android:text="Please attach the biometric device to register thumb impressions"
                    android:layout_marginStart="@dimen/x10"
                    android:layout_marginEnd="@dimen/x10"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="#ff000000"
                    android:gravity="center"
                    android:id="@+id/action_state"
                    android:background="#ffbbbbdd"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="@string/action_state_default"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="true">
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_weight="1">
                        <TextView
                            android:textSize="14sp"
                            android:textColor="#ff000000"
                            android:gravity="center"
                            android:id="@+id/device_count_title"
                            android:background="#ffccccee"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/device_count_name"/>
                        <TextView
                            android:textSize="14sp"
                            android:textColor="#ff000000"
                            android:gravity="center"
                            android:id="@+id/device_count"
                            android:background="#ffeeeeff"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/device_count_default"/>
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_weight="1">
                        <TextView
                            android:textSize="14sp"
                            android:textColor="#ff000000"
                            android:gravity="center"
                            android:id="@+id/status_title"
                            android:background="#ffccccee"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/status_name"/>
                        <TextView
                            android:textSize="14sp"
                            android:textColor="#ff000000"
                            android:gravity="center"
                            android:id="@+id/status"
                            android:background="#ffeeeeff"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/status_default"/>
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_weight="1">
                        <TextView
                            android:textSize="14sp"
                            android:textColor="#ff000000"
                            android:gravity="center"
                            android:id="@+id/frame_time_title"
                            android:background="#ffccccee"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/frame_time_name"/>
                        <TextView
                            android:textSize="14sp"
                            android:textColor="#ff000000"
                            android:gravity="center"
                            android:id="@+id/frame_time"
                            android:background="#ffeeeeff"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/frame_time_default"/>
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:background="#ffffffff"
                    android:paddingTop="10dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <Button
                        android:textSize="13sp"
                        android:layout_gravity="center"
                        android:id="@+id/refresh_btn"
                        android:padding="5sp"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/refresh_btn"
                        android:layout_weight="1"
                        android:layout_marginStart="10dp"
                        style="?android:attr/buttonBarButtonStyle"/>
                    <Button
                        android:textSize="13sp"
                        android:layout_gravity="center"
                        android:id="@+id/open_scanner_btn"
                        android:padding="5sp"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Start Scanning"
                        android:layout_weight="1"
                        android:layout_marginStart="5dp"
                        style="?android:attr/buttonBarButtonStyle"/>
                    <Button
                        android:textSize="13sp"
                        android:layout_gravity="center"
                        android:id="@+id/close_scanner_btn"
                        android:padding="10sp"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Stop Scanning"
                        android:layout_weight="1"
                        android:layout_marginStart="5dp"
                        style="?android:attr/buttonBarButtonStyle"/>
                    <Button
                        android:textSize="13sp"
                        android:layout_gravity="center"
                        android:id="@+id/start_capture_btn"
                        android:padding="10sp"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Start Scanning"
                        android:layout_weight="1"
                        android:layout_marginStart="5dp"
                        style="?android:attr/buttonBarButtonStyle"/>
                    <Button
                        android:textSize="13sp"
                        android:layout_gravity="center"
                        android:id="@+id/stop_capture_btn"
                        android:padding="10sp"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Stop Scanning"
                        android:layout_weight="1"
                        android:layout_marginStart="5dp"
                        style="?android:attr/buttonBarButtonStyle"/>
                    <Button
                        android:textSize="13sp"
                        android:layout_gravity="center"
                        android:id="@+id/empty_btn"
                        android:padding="10sp"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:layout_weight="1"
                        android:layout_marginStart="5dp"
                        style="?android:attr/buttonBarButtonStyle"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:background="#ffffffff"
                    android:paddingTop="10dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <ImageView
                        android:layout_gravity="center"
                        android:id="@+id/ma_profile_image"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginBottom="10dp"
                        android:src="@drawable/avatar"
                        android:scaleType="centerCrop"
                        android:layout_weight="1"
                        android:contentDescription="@string/preview_image"
                        android:layout_marginStart="20dp"/>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="40dp">
                        <Button
                            android:textSize="16sp"
                            android:textColor="@color/white"
                            android:gravity="fill_vertical"
                            android:id="@+id/view_database_btn"
                            android:background="@color/colorAccent"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:layout_margin="5dp"
                            android:text="@string/view_database_btn"
                            style="?android:attr/buttonBarButtonStyle"/>
                        <Spinner
                            android:textSize="16sp"
                            android:textColor="#ff000000"
                            android:id="@+id/capture_type"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="40dp">
                        <Spinner
                            android:textSize="16sp"
                            android:textColor="#ff000000"
                            android:id="@+id/action_type"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"/>
                    </LinearLayout>
                    <LinearLayout
                        android:layout_gravity="center_vertical"
                        android:orientation="vertical"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        android:layout_weight="1"
                        android:layout_marginStart="20dp"
                        android:layout_marginEnd="20dp">
                        <TextView
                            android:textSize="16sp"
                            android:textColor="#ff000000"
                            android:gravity="center"
                            android:id="@+id/description"
                            android:background="#ffff0000"
                            android:visibility="gone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:maxLines="2"/>
                        <LinearLayout
                            android:orientation="horizontal"
                            android:background="#ffcccccc"
                            android:layout_width="match_parent"
                            android:layout_height="12sp">
                            <TextView
                                android:textSize="12sp"
                                android:id="@+id/scan_states_color1"
                                android:background="#ff00ff00"
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:text=""
                                android:layout_weight="1"
                                android:layout_marginStart="10sp"
                                android:layout_marginEnd="10sp"/>
                            <TextView
                                android:textSize="12sp"
                                android:id="@+id/scan_states_color2"
                                android:background="#ff0000ff"
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:layout_marginRight="10sp"
                                android:text=""
                                android:layout_weight="1"
                                android:layout_marginEnd="10sp"/>
                            <TextView
                                android:textSize="12sp"
                                android:id="@+id/scan_states_color3"
                                android:background="#ff00ffff"
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:layout_marginRight="10sp"
                                android:text=""
                                android:layout_weight="1"
                                android:layout_marginEnd="10sp"/>
                            <TextView
                                android:textSize="12sp"
                                android:id="@+id/scan_states_color4"
                                android:background="#ffff00ff"
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:layout_marginRight="10sp"
                                android:text=""
                                android:layout_weight="1"
                                android:layout_marginEnd="10sp"/>
                        </LinearLayout>
                        <ImageView
                            android:layout_gravity="center"
                            android:id="@+id/preview_image"
                            android:background="#ffeeeeee"
                            android:paddingBottom="7sp"
                            android:layout_width="165dp"
                            android:layout_height="142dp"
                            android:contentDescription="@string/preview_image"
                            android:paddingStart="14sp"
                            android:paddingEnd="14sp"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/ll_ma_profile"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="@dimen/textsize_medium"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:background="@color/boundary_wall_text_bg_color"
                    android:padding="15dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/x10"
                    android:text="Profile"/>
                <androidx.cardview.widget.CardView
                    android:layout_gravity="center"
                    android:id="@+id/cv_ma_profile"
                    android:background="@color/white"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/x10"
                    android:layout_marginBottom="@dimen/x10"
                    android:layout_marginStart="@dimen/x5"
                    android:layout_marginEnd="@dimen/x5"
                    card_view:cardCornerRadius="2dp"
                    card_view:cardElevation="@dimen/x4">
                    <LinearLayout
                        android:orientation="horizontal"
                        android:padding="@dimen/x10"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <LinearLayout
                            android:orientation="vertical"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1">
                            <LinearLayout
                                android:orientation="horizontal"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:weightSum="3">
                                <TextView
                                    android:textAppearance="?android:attr/textAppearanceMedium"
                                    android:textSize="@dimen/textsize_medium"
                                    android:textStyle="bold"
                                    android:textColor="@color/colorPrimary"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:text="Name:"
                                    android:layout_weight="1"/>
                                <TextView
                                    android:textAppearance="?android:attr/textAppearanceMedium"
                                    android:textSize="@dimen/textsize_medium"
                                    android:textColor="@color/black"
                                    android:id="@+id/tv_ma_name"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:text="n/a"
                                    android:layout_weight="2"
                                    android:layout_marginStart="@dimen/x10"/>
                            </LinearLayout>
                            <LinearLayout
                                android:orientation="horizontal"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/x6"
                                android:weightSum="3">
                                <TextView
                                    android:textAppearance="?android:attr/textAppearanceMedium"
                                    android:textSize="@dimen/textsize_medium"
                                    android:textStyle="bold"
                                    android:textColor="@color/colorPrimary"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:text="ID:"
                                    android:layout_weight="1"/>
                                <TextView
                                    android:textAppearance="?android:attr/textAppearanceMedium"
                                    android:textSize="@dimen/textsize_medium"
                                    android:textColor="@color/black"
                                    android:id="@+id/tv_ma_id"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:text="n/a"
                                    android:layout_weight="2"
                                    android:layout_marginStart="@dimen/x10"/>
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>
            <androidx.cardview.widget.CardView
                android:layout_gravity="center"
                android:id="@+id/cv_noData_RL"
                android:background="@color/white"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/x5"
                card_view:cardCornerRadius="2dp"
                card_view:cardElevation="@dimen/x4">
                <RelativeLayout
                    android:gravity="center"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/x50"
                    android:layout_margin="@dimen/x10">
                    <TextView
                        android:gravity="center"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="No Employee Exist"/>
                </RelativeLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
        <LinearLayout
            android:layout_gravity="bottom"
            android:id="@+id/footer"
            android:background="@color/whitesmoke"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/x5">
            <Button
                android:textColor="@color/white"
                android:id="@+id/save_button"
                android:background="@color/colorAccent"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/x2"
                android:text="   Save   "
                android:layout_weight="1"/>
            <Button
                android:textColor="@color/white"
                android:id="@+id/reset_button"
                android:background="@color/colorAccent"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/x2"
                android:text="   RESET   "
                android:layout_weight="1"/>
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
