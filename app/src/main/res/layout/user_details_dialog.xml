<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="#ffffffff"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10sp"
        android:layout_marginRight="10sp">
        <TextView
            android:textSize="@dimen/textsize_medium"
            android:textColor="#ff0060a0"
            android:gravity="left"
            android:id="@+id/user_details_name_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="10sp"
            android:text="user details name_text"
            android:layout_weight="1"/>
        <TextView
            android:textSize="@dimen/textsize_medium"
            android:textColor="#ff000000"
            android:gravity="right"
            android:id="@+id/user_details_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:layout_weight="1"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:background="#ffeeeeff"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10sp"
        android:layout_marginRight="10sp">
        <TextView
            android:textSize="@dimen/textsize_medium"
            android:textColor="#ff0060a0"
            android:gravity="left"
            android:id="@+id/user_details_description_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="10sp"
            android:text="user details_description_text"
            android:layout_weight="1"/>
        <TextView
            android:textSize="@dimen/textsize_medium"
            android:textColor="#ff000000"
            android:gravity="right"
            android:id="@+id/user_details_description"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:layout_weight="1"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10sp"
        android:layout_marginRight="10sp">
        <TextView
            android:textSize="@dimen/textsize_medium"
            android:textColor="#ff0060a0"
            android:gravity="left"
            android:id="@+id/user_details_create_date_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="10sp"
            android:text="user details create_date_text"
            android:layout_weight="1"/>
        <TextView
            android:textSize="@dimen/textsize_medium"
            android:textColor="#ff000000"
            android:gravity="right"
            android:id="@+id/user_details_create_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:layout_weight="1"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:background="#ffeeeeff"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10sp"
        android:layout_marginRight="10sp">
        <TextView
            android:textSize="@dimen/textsize_medium"
            android:textColor="#ff0060a0"
            android:gravity="left"
            android:id="@+id/user_details_modify_date_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="10sp"
            android:text="user details modify_date_text"
            android:layout_weight="1"/>
        <TextView
            android:textSize="@dimen/textsize_medium"
            android:textColor="#ff000000"
            android:gravity="right"
            android:id="@+id/user_details_modify_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:layout_weight="1"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10sp"
        android:layout_marginRight="10sp">
        <TextView
            android:textSize="@dimen/textsize_medium"
            android:textColor="#ff0060a0"
            android:gravity="left"
            android:id="@+id/user_details_match_score_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="10sp"
            android:text="user details match score text"
            android:layout_weight="1"/>
        <TextView
            android:textSize="@dimen/textsize_medium"
            android:textColor="#ff000000"
            android:gravity="right"
            android:id="@+id/user_details_match_score"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:layout_weight="1"/>
    </LinearLayout>
</LinearLayout>
