<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.cardview.widget.CardView
        android:layout_gravity="center"
        android:id="@+id/card_view"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/x5"
        card_view:cardCornerRadius="2dp"
        card_view:cardElevation="@dimen/x4">
        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_margin="@dimen/x10">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toLeftOf="@+id/checked"
                android:layout_centerVertical="true"
                android:layout_alignParentStart="true">
                <TextView
                    android:textSize="@dimen/textsize_large"
                    android:textColor="@color/black"
                    android:id="@+id/tv_shool_name"
                    android:padding="@dimen/x2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="aaosajso"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:padding="@dimen/x2"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="@dimen/x2"
                    android:layout_marginBottom="@dimen/x2">
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <TextView
                            android:textSize="@dimen/x14"
                            android:textColor="@color/gray"
                            android:ellipsize="end"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_margin="@dimen/x2"
                            android:text="monitoring start date"/>
                        <TextView
                            android:textSize="@dimen/x14"
                            android:textColor="@color/gray"
                            android:ellipsize="end"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:layout_margin="@dimen/x2"
                            android:text="monitoring end date"/>
                        <TextView
                            android:textSize="@dimen/x14"
                            android:textColor="@color/gray"
                            android:ellipsize="end"
                            android:id="@+id/tv_lbl_semisCodeScheoolDetail"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:layout_margin="@dimen/x2"
                            android:text="semis code School"/>
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <TextView
                            android:textSize="@dimen/x14"
                            android:textColor="@color/gray"
                            android:id="@+id/tv_m_start_time"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_margin="@dimen/x2"
                            android:text="-"
                            android:paddingStart="@dimen/x2"/>
                        <TextView
                            android:textSize="@dimen/x14"
                            android:textColor="@color/gray"
                            android:id="@+id/tv_m_end_date"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_margin="@dimen/x2"
                            android:text="-"
                            android:paddingStart="@dimen/x2"/>
                        <TextView
                            android:textSize="@dimen/x14"
                            android:textColor="@color/gray"
                            android:id="@+id/tv_semisCodeScheoolDetail"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_margin="@dimen/x2"
                            android:text="-"
                            android:paddingStart="@dimen/x2"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
            <CheckBox
                android:enabled="false"
                android:id="@+id/checked"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/x5"
                android:button="@drawable/customdrawablecheckbox"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
    </androidx.cardview.widget.CardView>
</LinearLayout>
