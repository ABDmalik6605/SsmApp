<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/parent"
    android:background="@drawable/splash"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:layout_behavior="@string/appbar_scrolling_view_behavior">
    <ScrollView
        android:id="@+id/scv"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/maincontent_logo"
                android:background="@drawable/login_logo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:elevation="@dimen/x5"/>
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:id="@+id/content_main_linearlayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/x40"
                android:layout_below="@+id/maincontent_logo"
                android:layout_centerHorizontal="true">
                <EditText
                    android:textSize="@dimen/s20"
                    android:textColor="@color/black"
                    android:id="@+id/edit_user"
                    android:background="@drawable/rounded_border_gray"
                    android:paddingLeft="@dimen/activity_horizontal_margin"
                    android:paddingTop="@dimen/activity_vertical_margin"
                    android:paddingRight="@dimen/activity_horizontal_margin"
                    android:paddingBottom="@dimen/activity_vertical_margin"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/x120"
                    android:layout_marginTop="@dimen/x2"
                    android:layout_marginBottom="@dimen/x2"
                    android:hint="User Name"
                    android:maxLines="1"
                    android:maxLength="25"
                    android:drawablePadding="@dimen/x12"
                    android:inputType="textNoSuggestions"
                    android:drawableStart="@drawable/login_iconuser"
                    android:layout_marginStart="@dimen/x25"
                    android:layout_marginEnd="@dimen/x25"/>
                <EditText
                    android:textSize="@dimen/s20"
                    android:textColor="@color/black"
                    android:id="@+id/edit_pass"
                    android:background="@drawable/rounded_border_gray"
                    android:paddingLeft="@dimen/activity_horizontal_margin"
                    android:paddingTop="@dimen/activity_vertical_margin"
                    android:paddingRight="@dimen/activity_horizontal_margin"
                    android:paddingBottom="@dimen/activity_vertical_margin"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/x120"
                    android:layout_marginTop="@dimen/x2"
                    android:layout_marginBottom="@dimen/x2"
                    android:hint="Password"
                    android:maxLines="1"
                    android:maxLength="15"
                    android:drawablePadding="@dimen/x12"
                    android:inputType="textPassword"
                    android:drawableStart="@drawable/login_iconpass"
                    android:layout_marginStart="@dimen/x25"
                    android:layout_marginEnd="@dimen/x25"/>
                <Button
                    android:id="@+id/btnlogin"
                    android:background="@drawable/login_btnlogin"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/x100"
                    android:layout_marginTop="@dimen/activity_horizontal_margin"
                    android:layout_marginBottom="@dimen/x2"
                    android:layout_marginStart="@dimen/x25"
                    android:layout_marginEnd="@dimen/x25"
                    android:elevation="@dimen/x5"/>
                <Button
                    android:id="@+id/btnforgot"
                    android:background="@drawable/login_btnforgotpassword"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/x100"
                    android:layout_marginTop="@dimen/x2"
                    android:layout_marginBottom="@dimen/x2"
                    android:textAllCaps="true"
                    android:layout_marginStart="@dimen/x25"
                    android:layout_marginEnd="@dimen/x25"
                    android:elevation="@dimen/x5"/>
                <Button
                    android:textSize="@dimen/s20"
                    android:textColor="@color/dark_grey_color"
                    android:id="@+id/btn_privacy"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/activity_horizontal_margin"
                    android:text="Privacy Policy"
                    style="@style/Widget.MaterialComponents.Button.TextButton"/>
            </LinearLayout>
        </RelativeLayout>
    </ScrollView>
</RelativeLayout>
