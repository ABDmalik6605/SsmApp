<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:background="@color/boundary_wall_text_bg_color"
        android:layout_width="match_parent"
        android:layout_height="75dp">
        <TextView
            android:textSize="@dimen/textsize_medium"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/tv_census_widget"
            android:background="@color/boundary_wall_text_bg_color"
            android:padding="15dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Restore Backup"
            android:layout_centerInParent="true"/>
    </RelativeLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/x40"
        android:weightSum="3"
        android:layout_marginStart="@dimen/x20"
        android:layout_marginEnd="@dimen/x20">
        <TextView
            android:textAppearance="?android:attr/textAppearanceMedium"
            android:textColor="@color/black"
            android:gravity="start"
            android:id="@+id/tv_last"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Last Backup: "
            android:layout_weight="1"/>
        <TextView
            android:textAppearance="?android:attr/textAppearanceMedium"
            android:textColor="@color/gray"
            android:gravity="start"
            android:id="@+id/tv_lastbackup"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text=""
            android:layout_weight="2"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/x40"
        android:weightSum="3"
        android:layout_marginStart="@dimen/x20"
        android:layout_marginEnd="@dimen/x20">
        <TextView
            android:textAppearance="?android:attr/textAppearanceMedium"
            android:textColor="@color/black"
            android:gravity="start"
            android:id="@+id/tv_size"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Size: "
            android:layout_weight="1"/>
        <TextView
            android:textAppearance="?android:attr/textAppearanceMedium"
            android:textColor="@color/gray"
            android:gravity="start"
            android:id="@+id/tv_sizevalue"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text=""
            android:layout_weight="2"/>
    </LinearLayout>
    <Button
        android:textColor="@color/white"
        android:layout_gravity="center_horizontal"
        android:id="@+id/btn_restore_backup"
        android:background="@color/colorAccent"
        android:padding="@dimen/x5"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/x35"
        android:text="   RESTORE BACKUP   "/>
</LinearLayout>
