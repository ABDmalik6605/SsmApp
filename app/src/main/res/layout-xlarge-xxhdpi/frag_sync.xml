<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:background="@color/boundary_wall_text_bg_color"
        android:layout_width="match_parent"
        android:layout_height="75dp">
        <TextView
            android:textSize="@dimen/textsize_medium"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/tv_title"
            android:background="@color/boundary_wall_text_bg_color"
            android:padding="15dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sync Data"
            android:layout_centerInParent="true"/>
        <ImageView
            android:id="@+id/iv_refresh"
            android:padding="@dimen/x5"
            android:layout_width="75dp"
            android:layout_height="75dp"
            android:src="@drawable/ic_refresh_white_48dp"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"/>
    </RelativeLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_search_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true">
        <ProgressBar
            android:id="@+id/sync_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/x40"
            android:layout_marginBottom="@dimen/x10"
            android:max="100"
            android:progress="0"
            android:layout_marginStart="@dimen/x40"
            android:layout_marginEnd="@dimen/x40"
            style="?android:attr/progressBarStyleHorizontal"/>
        <TextView
            android:layout_gravity="center"
            android:id="@+id/sync_text"
            android:background="@android:color/transparent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/x40"
            android:text="0% from 100%"
            android:layout_alignLeft="@+id/sync_progress"
            android:layout_alignTop="@+id/sync_progress"
            android:layout_alignRight="@+id/sync_progress"
            android:layout_alignBottom="@+id/sync_progress"/>
    </LinearLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerview"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/ll_search_bar"/>
</LinearLayout>
